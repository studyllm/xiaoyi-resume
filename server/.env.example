# 服务端的本地环境变量。复制成同目录下的 .env 后按需改。
# 服务端启动时读这个文件；进程环境里已有的同名变量优先于文件里的取值。
# 密钥不进代码库（docs/privacy-conclusions.md §4.2）。

# 数据库连接串。默认指向 docker-compose 起的那个 Postgres。
DATABASE_URL=postgres://xiaoyi:xiaoyi_local_dev@127.0.0.1:5432/xiaoyi

# 邮件。默认指向 docker-compose 里的 Mailpit——它收信不发信，
# 验证链接在 http://localhost:8025 里看。
#
# 换成真实服务商时注意三件事：
# - **SMTP_SECURE 要跟端口对上**：465 是隐式 TLS 端口，SMTP_SECURE 必须是 true；
#   用明文去连 465，对面会直接掐断连接，报出来的是「Connection closed
#   unexpectedly」，看不出是哪配错了。服务端启动时会自检并说清怎么改。
# - **SMTP_PASS 是授权码，不是登录密码**。服务商后台给的「授权码」才是这个值。
# - **SMTP_USER 要用服务商那边的发信账号**，不是随便填一个邮箱：
#   QQ 邮箱填你的 QQ 邮箱地址、主机是 smtp.qq.com、密码是 QQ 邮箱设置里
#   生成的授权码；企业邮件服务填服务商后台里已验证域名下的地址。
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=x
SMTP_PASS=x
MAIL_FROM=noreply@xiaoyi.local

# 站点对外地址。验证与重置链接指向它。
SITE_URL=http://localhost:5173

# 巡检告警发给谁。留空就只把告警打在日志里（server/scripts/daily-check.ts）
ALERT_EMAIL=

# 备份桶与区域。巡检会用它确认「昨晚的备份有没有成功」
S3_BUCKET=
AWS_REGION=cn-hangzhou
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 服务端监听
HOST=127.0.0.1
PORT=3000

# 模型供应商（OpenAI 兼容格式）。**三个都填上才启用**，否则生成路径走规则引擎。
# 密钥不进代码库（docs/privacy-conclusions.md §4.2）。上线前核对供应商的
# 数据留存与是否用于训练条款（docs/adr/0005-llm-access-shape.md §4）。
#LLM_BASE_URL=https://model.example.com/v1
#LLM_API_KEY=
#LLM_MODEL=
# 单次调用的超时与输出 token 上限。成本护栏的第一道闸。
#
# 这两个值按「一整版简历」来定，不是按一次问答。实测（MiniMax-M3.1-Flash，
# 简历 77 条要点）：
# - **超时**：要 10 分钟上下（每条约 7.6 秒）。120 秒不够，撞上了就整版回落
#   规则引擎——等了两分钟拿到的还是规则写的。要点越多越慢，给 900 秒。
# - **输出上限**：16000 不够（推理内容占了 78% 的额度，正文没轮到就被截断，
#   finish_reason=length）。给 32000。
#
# **这两个值不配也能跑**——服务端的默认值就是按上面的实测值给的（超时 900 秒、
# 输出 32000），只填上面三个供应商变量就够。显式写出来更保险：换了模型可能要
# 跟着调。撞上截断时界面会说「请调大 LLM_MAX_TOKENS」，撞上超时会说「请调大
# LLM_TIMEOUT_MS」，那时候改这里就行。
#
# 换更快的模型或关掉深度思考，比调这两个数管用。
#LLM_TIMEOUT_MS=900000
#LLM_MAX_TOKENS=32000

# 比对时最多发多少条要点给模型。默认 40。
#
# **裁剪只影响模型能看到什么，不影响系统能判定什么**：模型判「未覆盖」的
# 要求，系统会用规则引擎在简历的**全部**要点上再判一次，所以未覆盖清单
# 不会因为裁剪而失真。
#
# 调大 → 模型看得更全，提示词更长、更慢、更贵；调小 → 只挑最相关的那些。
# 改了它之后，**已经算过的比对结果不会重算**（缓存键里没有这个数）——
# 运营上改完配置要清一次 `jd_analyses`。
#LLM_MAX_CANDIDATE_BULLETS=40

# 客户端等待模型的上限由服务端下发：`GET /api/v1/engine` 返回 `timeoutMs`
# （就是上面的 LLM_TIMEOUT_MS），前端加一分钟余量后作为自己的等待上限。
# 两边各写一个数迟早会脱节——契约里原来那个「30 秒」会把每一次真实的模型
# 调用都掐掉。
#
# 客户端超时早于服务端完成时，用户会看到「模型响应超时」，提示里写明了
# 刷新版本列表看看（这次可能已经生成好了）。`Idempotency-Key` 保证重试
# 不会生成第二份。
