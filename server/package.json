{
  "name": "@xiaoyi/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "服务端：账号、会话、存储，以及引擎宿主——引擎跑的是共享包里的同一份源码。",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run type-check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@xiaoyi/shared": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
